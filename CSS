/* --- RESET & BASE --- */
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, sans-serif;
  line-height: 1.5;
  color: #333;
}

/* --- CONTAINER --- */
.container {
  max-width: 1000px;
  margin: 0 auto;
  padding: 0 16px; /* horizontal padding to avoid screen edges */
}

/* --- HEADER --- */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px;
  border-bottom: 1px solid #ddd;
  flex-wrap: wrap;
}

.logo {
  font-size: 1.5rem;
  font-weight: bold;
}

.nav {
  display: flex;
  gap: 16px;
}

.nav a {
  text-decoration: none;
  color: #333;
  font-weight: 500;
}

/* --- HERO SECTION --- */
.hero {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20px;
  padding: 20px 0;
  flex-wrap: wrap;
}

.hero-text {
  flex: 1 1 300px;
}

.hero-text h1 {
  font-size: 2rem;
  margin-bottom: 8px;
}

.hero-text p {
  margin-bottom: 12px;
}

.hero-card {
  flex: 0 0 240px;
  padding: 16px;
  border: 1px solid #ddd;
  text-align: center;
  border-radius: 8px;
  background-color: #f9f9f9;
}

/* --- BUTTON --- */
.btn {
  display: inline-block;
  padding: 10px 16px;
  background-color: #0d6efd;
  color: white;
  text-decoration: none;
  border-radius: 5px;
  transition: background 0.3s;
}

.btn:hover {
  background-color: #084298;
}

/* --- GRID SECTION --- */
.grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
  padding: 20px 0;
}

.card {
  border: 1px solid #ddd;
  padding: 18px;
  text-align: center;
  border-radius: 8px;
  background-color: #f1f1f1;
  transition: transform 0.2s, box-shadow 0.2s;
}

.card:hover {
  transform: translateY(-4px);
  box-shadow: 0 4px 8px rgba(0,0,0,0.1);
}

/* --- FOOTER --- */
.footer {
  padding: 16px;
  text-align: center;
  border-top: 1px solid #ddd;
  background-color: #f8f8f8;
}

/* --- MEDIA QUERIES --- */

/* Mobile: max-width 600px */
@media (max-width: 600px) {
  .header {
    flex-direction: column;
    align-items: center;
  }

  .nav {
    flex-direction: column;
    align-items: center;
  }

  .hero {
    flex-direction: column;
    align-items: center;
  }

  .grid {
    grid-template-columns: 1fr;
  }
}

/* Tablet: 601px to 900px */
@media (min-width: 601px) and (max-width: 900px) {
  .grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

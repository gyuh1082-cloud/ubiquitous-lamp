/* --- 2. Container Sizing & Centering (4 pts) --- */
* { box-sizing: border-box; }

body { 
    margin: 0; 
    font-family: Arial, sans-serif; 
}

.container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 20px; /* Horizontal padding for screen edges */
}

/* --- 1. Header Layout (7 pts) --- */
.header {
    padding: 16px 0;
    border-bottom: 1px solid #ddd;
}

.header-container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    justify-content: space-between; /* Desktop: Logo left, Nav right */
    align-items: center;
}

.nav a { 
    margin-left: 15px; 
    text-decoration: none;
    color: #333;
}

/* Mobile Header (max-width: 600px) */
@media (max-width: 600px) {
    .header-container {
        flex-direction: column; /* Stacked */
        text-align: center;     /* Centered */
    }
    .nav {
        margin-top: 10px;
    }
    .nav a {
        margin: 0 8px;
    }
}

/* --- 3. Hero Section (6 pts) --- */
.hero {
    display: flex;
    padding: 40px 0;
    align-items: center;
    justify-content: space-between; /* Hero card aligns to the right */
}

.hero-text { flex: 1; }

.hero-card {
    width: 240px;
    padding: 16px;
    border: 1px solid #ddd;
    text-align: center;
    background: #f9f9f9;
}

/* Mobile Hero (max-width: 600px) */
@media (max-width: 600px) {
    .hero {
        flex-direction: column; /* Stacks vertically */
        text-align: center;
    }
    .hero-card {
        margin-top: 20px;
        width: 100%; /* Card takes full width on mobile */
    }
}

/* --- 4. Grid Section Breakpoints (6 pts) --- */
.grid {
    display: grid;
    gap: 12px;
    padding: 20px 0;
}

/* Desktop: 4 columns (Default/Fallback) */
@media (min-width: 901px) {
    .grid { grid-template-columns: repeat(4, 1fr); }
}

/* Tablet: 2 columns (601px to 900px) */
@media (min-width: 601px) and (max-width: 900px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
}

/* Mobile: 1 column (0px to 600px) */
@media (max-width: 600px) {
    .grid { grid-template-columns: 1fr; }
}

/* --- 5. Hover Styles (2 pts) --- */
.card {
    border: 1px solid #ddd;
    padding: 40px 18px;
    text-align: center;
    transition: transform 0.2s, box-shadow 0.2s;
}

.card:hover {
    transform: translateY(-5px);
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    border-color: #666;
}

.btn {
    display: inline-block;
    padding: 10px 14px;
    border: 1px solid black;
    text-decoration: none;
    color: black;
    transition: background 0.3s, color 0.3s;
}

.btn:hover {
    background: black;
    color: white;
}

.footer {
    padding: 16px;
    text-align: center;
    border-top: 1px solid #ddd;
    margin-top: 40px;
}
